{
  "policy_format_version": "0.3.0",
  "repository_kind": "documentation",
  "enforcement": {
    "mode": "advisory"
  },
  "packs": {
    "requirements-strict": {
      "requirement_json_globs": [
        "requirements/*.json"
      ],
      "requirement_id_pattern": "PVE-(?:GOV|SRC|AUD|MATH|PHY|EVD|STATE|HYG)-[0-9]{3}",
      "closed_repository": false,
      "strict_heading_docs": [
        "requirements/index.md"
      ],
      "evidence_surfaces": [
        "README.md",
        "docs/**",
        "requirements/index.md",
        "audit/**",
        "formal/**",
        "compute/**",
        "checks/**",
        "experiments/**",
        "sources/**",
        ".github/**"
      ],
      "changed_requirement_evidence_surfaces": [
        "README.md",
        "docs/**",
        "requirements/index.md",
        "audit/**",
        "checks/**",
        ".github/**"
      ],
      "affected_evidence_surfaces": [
        "README.md",
        "docs/**",
        "audit/**",
        "formal/**",
        "compute/**",
        "checks/**",
        "experiments/**",
        "sources/**",
        ".github/**"
      ],
      "implementation_evidence_surfaces": [
        "formal/**",
        "compute/**",
        "scripts/**",
        "checks/**",
        ".github/**"
      ],
      "verification_evidence_surfaces": [
        "checks/**",
        "audit/**",
        "formal/**",
        "compute/**",
        "experiments/**",
        ".github/**"
      ]
    }
  },
  "paths": {
    "forbidden": [
      "legacy/**",
      "archive/**",
      "old/**",
      "deprecated/**",
      "*.bak",
      "*.tmp",
      "*.orig"
    ],
    "canonical_docs": [
      "README.md",
      "docs/research-protocol.md",
      "docs/book-audit-plan.md",
      "docs/repository-hygiene.md"
    ],
    "governance_paths": [
      "repo-policy.json",
      "requirements/**",
      "docs/research-protocol.md",
      "docs/book-audit-plan.md",
      "docs/repository-hygiene.md",
      "checks/audit-integrity.mjs",
      ".github/workflows/repo-guard.yml",
      ".github/workflows/research-integrity.yml",
      ".github/workflows/branch-hygiene.yml",
      ".github/workflows/collaboration-hygiene.yml",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/ISSUE_TEMPLATE/**",
      ".anet/memory.json"
    ],
    "pr_immutable": [
      "Николаев Г.В. – Электродинамика физического вакуума – 2004.pdf"
    ],
    "operational_paths": []
  },
  "diff_rules": {
    "max_new_docs": 25,
    "max_new_files": 50,
    "max_net_added_lines": 9000
  },
  "content_rules": [],
  "cochange_rules": []
}
